<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PhoneCut" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="SubtitleText" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/subtitle_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>
</resources>
